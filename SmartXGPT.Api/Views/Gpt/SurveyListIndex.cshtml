@using SmartXGPT.Service.Models.DTOs
@model List<SurveyResultDto>

<section class="section">
    <div class="container">

        <div class="row">
            <div class="col-lg-8 col-md-6 mt-4 pt-2">
                <a class="btn btn-primary" asp-action="GptManualCall" asp-controller="Gpt"> سوال از GPT </a>
                <a class="btn btn-primary" asp-action="GptManualCallWithContext" asp-controller="Gpt"> سوال از GPT with context</a>
                <a class="btn btn-primary" asp-action="NewSurvey" asp-controller="Gpt"> فرم نظر سنجی </a>
                <a class="btn btn-info ms-2" asp-action="SurveyListIndex" asp-controller="Gpt"><i class="fa fa-refresh"></i></a>
                <a class="btn btn-info ms-2" asp-action="Assistant" asp-controller="Gpt">assistant</a>
            </div>

        </div><!--end row--> 
        <div class="row">
            <div class="col-12">
                <div class="table-responsive bg-white shadow rounded">
                    <table class="table mb-0 table-center">
                        <thead>
                            <tr>
                                <th class="border-bottom fw-medium py-3" style="min-width:20px "></th>
                                <th class="border-bottom fw-medium align-items-center  py-3" style="min-width: 100px;">مشتری</th>
                                <th class="border-bottom fw-medium text-center py-3" style="min-width: 160px;">رستوران</th>
                                <th class="border-bottom fw-medium text-center py-3" style="min-width: 100px;">کیفیت</th>
                                <th class="border-bottom fw-medium text-center py-3" style="min-width: 100px;">بهداشت</th>
                                <th class="border-bottom fw-medium text-center py-3" style="min-width: 100px;">قیمت</th>
                                <th class="border-bottom fw-medium text-center py-3" style="min-width: 100px;">رفتار</th>
                                <th class="border-bottom fw-medium text-center py-3" style="min-width: 100px;">مجموع</th>
                                <th class="border-bottom fw-medium text-center py-3" style="min-width: 160px;">کامنت</th>
                                <th class="border-bottom fw-medium text-end py-3 pe-4" style="min-width: 130px;">عملیات</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null)
                            {
                                @foreach (var item in Model)
                                {
                                    <tr class="shop-list">
                                        <td class="h6 text-center"><a class="text-danger" href="javascript:void(0)"><i class="uil uil-times"></i></a></td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <h6 class="mb-0 ms-3">@item.CustomerName</h6>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.RestaurantName</td>
                                        <td class="text-center">@item.FoodQuality</td>
                                        <td class="text-center">@item.Cleanliness</td>
                                        <td class="text-center">@item.Price</td>
                                        <td class="text-center">@item.Behavior</td>
                                        <td class="text-center">@item.Overall</td>
                                        <td class="text-end fw-medium pe-4"><p >@((item.Comment != null) ? ((item.Comment.Length > 50) ? item.Comment.Substring(0, 50) : item.Comment) : " ")</p></td>
                                        <td class="text-center qty-icons">
                                            <a class="btn btn-pills btn-icon btn-primary" asp-action="ViewSurvey" asp-controller="Gpt" asp-route-id="@item.Id"><i class="fa fa-file-text"></i></a>
                                            <a class="btn btn-pills btn-icon btn-primary" asp-action="EditSurvey" asp-controller="Gpt" asp-route-id="@item.Id"><i class="fa fa-edit"></i></a>

                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div><!--end col-->
        </div><!--end row-->
    </div><!--end container-->
</section>
<script>
    if (@ViewBag.alert!= null)
        alert(@ViewBag.alert);
</script>
