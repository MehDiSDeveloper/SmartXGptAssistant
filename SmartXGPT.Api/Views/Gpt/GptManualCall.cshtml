@using SmartXGPT.Service.Models.DTOs;

@model MesssageGPTDto
@{
    ViewData["Title"] = "GPT Call";
}

<section class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-lg-5">
                <div class="card rounded shadow p-4 border-0">

                    <a class="btn btn-pills btn-icon btn-primary mb-4" asp-action="SurveyListIndex" asp-controller="Gpt"><i class="fa fa-list"></i></a>

                    <form class="needs-validation" novalidate="" asp-action="GptManualCall" asp-controller="Gpt" method="post">
                        <div class="row g-3">
                            <input class="disabled" hidden asp-for="Id" />
                            <input type="checkbox" class="disabled" hidden asp-for="IsManual" checked value="true"/>
                        </div>


                        <div class="form-check mt-4 pt-4">

                            <h4 class="mb-3 mt-4 pt-4 border-top">سوال</h4>
                            <br />
                            <textarea class="form-control-lg form-control  p-5" asp-for="FaQuestion"></textarea>
                            <div class="form-check mt-4 pt-4 border-top">
                                <div class="col-md-12">
                                    <label class="form-label" for="Temperature">Temperature</label>
                                    <br />
                                    <span asp-validation-for="Temperature" class="text-danger"></span>
                                    <input type="number" asp-for="Temperature" class="form-control-lg form-control " placeholder="0.8" value="0.8" />
                                </div>
                            </div>
                            <div class="form-check pt-2">
                                <input class="form-check-input" type="checkbox" asp-for="DoTranslate" value="true">
                                <label class="form-check-label" for="DoTranslate">با ترجمه</label>
                            </div>
                        </div>

                        <button class="w-100 btn btn-primary mt-5" type="submit">ارسال</button>
                    </form>



                </div>
            </div><!--end col-->
            @if (Model != null)
            {

                <div class="col-md-6 col-lg-7 ">

                    <div class="card rounded shadow p-4 border-0 sticky-bar">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="h5 mb-0">نتایج</span>
                        </div>

                        <ul class="list-group mb-5 border message-back">

                            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                            {
                                <li class="d-flex justify-content-between lh-sm text-danger">
                                    <div>
                                        <h6 class="my-0">خطا</h6>
                                    </div>
                                    <span class="text-muted">@Model.ErrorMessage</span>
                                </li>
                            }
                            <div class="text-warning border-bottom">
                                <small>Temperature: @Model.Temperature ------</small>
                                @if (!string.IsNullOrEmpty(Model.FaAnswer)&&!string.IsNullOrEmpty(Model.FaQuestion))
                                {

                                    int tokens = Model.FaAnswer.Length + Model.FaQuestion.Length;


                                    <small>Total-Used-Tokens: @tokens ------</small>
                                }
                                @if (Model.DoTranslate)
                                {
                                    <small>With-Translation</small>
                                }
                                else
                                {
                                    <small>No-Translation</small>
                                }
                            </div>
                            <li class="d-flex justify-content-between lh-sm mt-2 ">
                                <div>
                                    <h6 class="my-0">سوال</h6>
                                    <div class="mt-2">
                                        @if (!string.IsNullOrEmpty(Model.FaQuestion))
                                        {
                                            <small class="text-muted">Tokens: @Model.FaQuestion.Length</small>
                                        }
                                    </div>
                                </div>
                            </li>
                            <li class="d-flex justify-content-between lh-sm">
                                <div class="form-check pt-2 border-top">
                                    <p class="text-muted">@Model.FaQuestion</p>
                                </div>
                            </li>

                            <li class="d-flex justify-content-between lh-sm border-top pt-4 ">
                                <div>
                                    <h6 class="my-0">پاسخ</h6>
                                    <div class="mt-2">
                                        <small class="text-muted">Tokens: @Model.FaAnswer.Length</small>
                                    </div>
                                </div>
                            </li>
                            <li class="d-flex justify-content-between lh-sm">

                                <div class="form-check pt-2 border-top">
                                    @Html.Raw(Model.FaAnswer)
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <div class="col-md-6 col-lg-7 order-md-last">
                    <div class="card rounded shadow p-4 border-0 sticky-bar">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="h5 mb-0 text-warning">محل نمایش پاسخ</span>
                        </div>
                    </div>
                </div>
            }

            <!--end col-->
        </div>
    </div>


</section>