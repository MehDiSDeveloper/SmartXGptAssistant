@using SmartXGPT.Service.Models.DTOs;

@model SurveyResultDto
<section class="section">
    <div class="container">
        <div class="row">

            <div class="col-md-5 col-lg-4">
                <div class="card rounded shadow p-4 border-0">
                    @if (Model != null)
                    {
                        <a class="btn btn-pills btn-icon btn-primary mb-4" asp-action="SurveyListIndex" asp-controller="Gpt"><i class="fa fa-list"></i></a>
                        <a class="btn btn-pills btn-icon btn-primary mb-4" asp-action="EditSurvey" asp-controller="Gpt" asp-route-id=@Model.Id><i class="fa fa-edit"></i></a>
                        <h4 class="mb-3">فرم نظرسنجی</h4>
                        <form class="needs-validation" novalidate="" asp-action="NewSurvey" asp-controller="Gpt" method="post">
                            <div class="row g-3">
                                <input class="disabled" hidden asp-for="Id" disabled />
                                <div class="col-sm-12">
                                    <label class="form-label" for="CustomerName">نام مشتری</label>
                                    <br />
                                    <input class="form-control" asp-for="CustomerName" required="" type="text" disabled>
                                    <div class="invalid-feedback"> نام معتبر مورد نیاز است. </div>
                                </div>
                                <div class="col-sm-12">
                                    <label class="form-label" for="RestaurantName">نام رستوران</label>
                                    <br />
                                    <input class="form-control" asp-for="RestaurantName" required="" type="text" disabled>
                                    <div class="invalid-feedback"> نام معتبر مورد نیاز است. </div>
                                </div>
                            </div>


                            <div class="form-check mt-4 pt-4 border-top">
                                <div class="col-md-12">
                                    <label class="form-label" for="FoodQuality">کیفیت غذا</label>
                                    <select class="form-select form-control" asp-for="FoodQuality" required="" disabled>
                                        <option value="0">انتخاب کنید</option>
                                        <option value="5">عالی</option>
                                        <option value="4">خوب</option>
                                        <option value="3">معمولی</option>
                                        <option value="2">بد</option>
                                        <option value="1">افتضاح</option>
                                    </select>
                                    <div class="invalid-feedback"> لطفاً یک وضعیت معتبر ارائه دهید. </div>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label" for="Cleanliness">بهداشت</label>
                                    <select class="form-select form-control" asp-for="Cleanliness" required="" disabled>
                                        <option value="0">انتخاب کنید</option>
                                        <option value="5">عالی</option>
                                        <option value="4">خوب</option>
                                        <option value="3">معمولی</option>
                                        <option value="2">بد</option>
                                        <option value="1">افتضاح</option>
                                    </select>
                                    <div class="invalid-feedback"> لطفاً یک وضعیت معتبر ارائه دهید. </div>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label" for="Price">قیمت غذا</label>
                                    <select class="form-select form-control" asp-for="Price" required="" disabled>
                                        <option value="0">انتخاب کنید</option>
                                        <option value="5">عالی</option>
                                        <option value="4">خوب</option>
                                        <option value="3">معمولی</option>
                                        <option value="2">بد</option>
                                        <option value="1">افتضاح</option>
                                    </select>
                                    <div class="invalid-feedback"> لطفاً یک وضعیت معتبر ارائه دهید. </div>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label" for="Behavior">رفتار پرسنل</label>
                                    <select class="form-select form-control" asp-for="Behavior" required="" disabled>
                                        <option value="0">انتخاب کنید</option>
                                        <option value="5">عالی</option>
                                        <option value="4">خوب</option>
                                        <option value="3">معمولی</option>
                                        <option value="2">بد</option>
                                        <option value="1">افتضاح</option>
                                    </select>
                                    <div class="invalid-feedback"> لطفاً یک وضعیت معتبر ارائه دهید. </div>
                                </div>
                                <div class="form-check mt-4 pt-4 border-top">
                                    <div class="col-md-12">
                                        <label class="form-label" for="Overall">در مجموع</label>
                                        <br />
                                        <select class="form-select form-control" asp-for="Overall" required="" disabled>
                                            <option value="">انتخاب کنید</option>
                                            <option value="5">عالی</option>
                                            <option value="4">خوب</option>
                                            <option value="3">معمولی</option>
                                            <option value="2">بد</option>
                                            <option value="1">افتضاح</option>>
                                        </select>
                                        <div class="invalid-feedback"> لطفاً یک وضعیت معتبر ارائه دهید. </div>
                                    </div>
                                </div>
                            </div>


                            <h4 class="mb-3 mt-4 pt-4 border-top">انتقاد و پیشنهاد</h4>
                            <br />
                            <textarea class="form-control-lg form-control  p-5" asp-for="Comment" disabled></textarea>

                            <div class="form-check mt-4 pt-4 border-top">
                                <div class="col-md-12">
                                    <label class="form-label" for="Temperature">Temperature</label>
                                    <br />
                                    <input type="number" class="form-control-lg form-control " asp-for="Temperature" disabled>
                                </div>
                            </div>
                            <div class="form-check pt-2 border-top">
                                <input class="form-check-input" type="checkbox" asp-for="DoSimple" disabled>
                                <label class="form-check-label" for="DoSimple">ساده</label>
                            </div>
                            <div class="form-check pt-2">
                                <input class="form-check-input" type="checkbox" asp-for="DoTranslate" disabled>
                                <label class="form-check-label" for="DoTranslate">با ترجمه</label>
                            </div>
                            <div class="form-check pt-2">
                                <input class="form-check-input" type="checkbox" asp-for="DoHierarchy" disabled>
                                <label class="form-check-label" for="DoHierarchy">با کانتکس</label>
                            </div>
                            <div class="form-check pt-2">
                                <input class="form-check-input" type="checkbox" asp-for="DoSms" value="true" disabled>
                                <label class="form-check-label" for="DoSms">پیامک</label>
                            </div>
                            <div class="form-check pt-2">
                                <input class="form-check-input" type="checkbox" asp-for="DoCommentSms" value="true" disabled>
                                <label class="form-check-label" for="DoCommentSms">پیامک کامنت</label>
                            </div>

                            <button class="w-100 btn btn-primary mt-5" type="submit" disabled>ارسال</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-pills btn-icon btn-primary mb-4" asp-action="SurveyListIndex" asp-controller="Gpt"><i class="fa fa-list"></i></a>

                    }
                </div>
            </div><!--end col-->


            @if (Model!=null && Model.Messages != null)
            {
                <div class="col-md-7 col-lg-8 order-md-last">
                    <div class="card rounded shadow p-4 border-0 sticky-bar">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="h5 mb-0">نتایج</span>
                            <span class="badge bg-primary rounded-pill">@Model.Messages.Count</span>
                        </div>
                        @foreach (var message in Model.Messages)
                        {
                            <ul class="list-group mb-5 border message-back p-3">

                                @if (!string.IsNullOrEmpty(message.ErrorMessage))
                                {
                                    <li class="d-flex justify-content-between lh-sm text-danger">
                                        <div>
                                            <h6 class="my-0">خطا</h6>
                                        </div>
                                        <span class="text-muted">@message.ErrorMessage</span>
                                    </li>
                                }
                                @switch (message.Type)
                                {
                                    case SmartXGPT.Service.Models.Entities.MessageType.Simple:
                                        <a class="btn btn-pills btn-icon btn-outline-warning mb-4" asp-action="DeleteMessage" asp-controller="Gpt" asp-route-messageId=@message.Id asp-route-surveyId=@Model.Id><i class="fa fa-remove"></i></a>
                                        <div class="text-warning border-bottom">
                                            <small>Temperature: @message.Temperature ------</small>

                                            @{
                                                int tokens = message.FaAnswer.Length + message.FaQuestion.Length;
                                            }

                                            <small>Total-Used-Tokens: @tokens ------</small>
                                            <small>No-Translation</small>
                                        </div>
                                        <li class="d-flex justify-content-between lh-sm mt-2 ">
                                            <div>
                                                <h6 class="my-0">سوال</h6>
                                                <div class="mt-2">
                                                    <small class="text-muted">Tokens: @message.FaQuestion.Length</small>
                                                </div>
                                            </div>
                                        </li>
                                        <li class="d-flex justify-content-between lh-sm">
                                            <div class="form-check pt-2 border-top">
                                                <p class="text-muted">@message.FaQuestion</p>
                                            </div>
                                        </li>

                                        <li class="d-flex justify-content-between lh-sm border-top pt-4 ">
                                            <div>
                                                <h6 class="my-0">پاسخ مستقیم</h6>
                                                <div class="mt-2">
                                                    <small class="text-muted">Tokens: @message.FaAnswer.Length</small>
                                                </div>
                                            </div>
                                        </li>
                                        <li class="d-flex justify-content-between lh-sm">

                                            <div class="form-check pt-2 border-top">
                                                @Html.Raw(@message.FaAnswer)
                                            </div>
                                        </li>
                                        break;
                                    case SmartXGPT.Service.Models.Entities.MessageType.Translated:
                                        <a class="btn btn-pills btn-icon btn-outline-warning mb-4" asp-route-surveyId=@Model.Id asp-action="DeleteMessage" asp-controller="Gpt" asp-route-messageId=@message.Id><i class="fa fa-remove"></i></a>
                                        <div class="text-warning border-bottom">
                                            <small>Temperature: @message.Temperature ------</small>

                                            @{
                                                int tokens2 = message.EnQuestion.Length + message.EnAnswer.Length;
                                            }

                                            <small>Total-Used-Tokens: @tokens2 ------</small>
                                            <small>With-Translation</small>
                                        </div>
                                        <li class="d-flex justify-content-between lh-sm mt-2 ">
                                            <div>
                                                <h6 class="my-0">سوال</h6>
                                                <div class="mt-2">
                                                    <small class="text-muted">Tokens: @message.FaQuestion.Length</small>
                                                </div>
                                            </div>
                                        </li>
                                        <li class="d-flex justify-content-between lh-sm">
                                            <div class="form-check pt-2 border-top">
                                                <p class="text-muted">@message.FaQuestion</p>
                                            </div>
                                        </li>

                                        <li class="d-flex justify-content-between lh-sm border-top pt-4 ">
                                            <div>
                                                <h6 class="my-0">پاسخ پس از ترجمه</h6>
                                                <div class="mt-2">
                                                    <small class="text-muted">Tokens: @message.EnAnswer.Length</small>
                                                </div>
                                            </div>
                                        </li>
                                        <li class="d-flex justify-content-between lh-sm">

                                            <div class="form-check pt-2 border-top">
                                                
                                                @Html.Raw(@message.FaAnswer)
                                            </div>
                                        </li>
                                        break;
                                    case SmartXGPT.Service.Models.Entities.MessageType.TranslatedHierarchy:
                                        <a class="btn btn-pills btn-icon btn-outline-warning mb-4" asp-route-surveyId=@Model.Id asp-action="DeleteMessage" asp-controller="Gpt" asp-route-messageId=@message.Id><i class="fa fa-remove"></i></a>

                                        <div class="text-warning border-bottom">
                                            <small>Tokens: @message.UsedTokens ------</small>

                                            <small>Temperature: @message.Temperature ------</small>
                                            <small>With-Translation ------</small>
                                            <small>With-Context</small>
                                        </div>
                                        foreach (var item in message.Questions)
                                        {
                                            <ul class="list-group mb-5 border question-back p-3">

                                            <li class="d-flex justify-content-between lh-sm ">
                                                <div>
                                                    <h6 class="my-0 mb-2">سوال</h6>
                                                        <div class="mt-2">
                                                            <small class="text-muted">Tokens: @item.Length</small>
                                                        </div>
                                                </div>
                                            </li>
                                            <li class="d-flex justify-content-between lh-sm">
                                                <div class="form-check pt-2 border-top">
                                                    <p class="text-muted">@item.QuestinString</p>
                                                </div>
                                            </li>

                                            <li class="d-flex justify-content-between lh-sm border-top pt-4 ">
                                                <div>
                                                    <h6 class="my-0">پاسخ</h6>
                                                    <div class="mt-2">
                                                        <small class="text-muted">Tokens: @item.Answer.Length</small>
                                                        
                                                    </div>
                                                </div>
                                            </li>
                                            <li class="d-flex justify-content-between lh-sm">

                                                <div class="form-check pt-2 border-top">
                                                        @Html.Raw(@item.Answer.AnswerString)
                                                </div>
                                            </li>
                                            </ul>
                                        }
                                        break;
                                    case SmartXGPT.Service.Models.Entities.MessageType.sms:
                                        <a class="btn btn-pills btn-icon btn-outline-warning mb-4" asp-route-surveyId=@Model.Id asp-action="DeleteMessage" asp-controller="Gpt" asp-route-messageId=@message.Id><i class="fa fa-remove"></i></a>

                                        <div class="text-warning border-bottom">
                                            <small>Temperature: @message.Temperature ------</small>

                                            @{
                                                int tokens3 = message.FaAnswer.Length + message.FaQuestion.Length;
                                            }

                                            <small>Total-Used-Tokens: @tokens3 ------</small>
                                            <small>SMS</small>
                                        </div>
                                        <li class="d-flex justify-content-between lh-sm mt-2 ">
                                            <div>
                                                <h6 class="my-0">سوال</h6>
                                                <div class="mt-2">
                                                    <small class="text-muted">Tokens: @message.FaQuestion.Length</small>
                                                </div>
                                            </div>
                                        </li>
                                        <li class="d-flex justify-content-between lh-sm">
                                            <div class="form-check pt-2 border-top">
                                                <p class="text-muted">@message.FaQuestion</p>
                                            </div>
                                        </li>

                                        <li class="d-flex justify-content-between lh-sm border-top pt-4 ">
                                            <div>
                                                <h6 class="my-0">SMS</h6>
                                                <div class="mt-2">
                                                    <small class="text-muted">Tokens: @message.FaAnswer.Length</small>
                                                </div>
                                            </div>
                                        </li>
                                        <li class="d-flex justify-content-between lh-sm">

                                            <div class="form-check pt-2 border-top">
                                                @Html.Raw(@message.FaAnswer)
                                            </div>
                                        </li>
                                        break;

                                }


                            </ul>
                        }

                    </div>
                </div>
            }
            else
            {
                <div class="col-md-7 col-lg-8 order-md-last">
                    <div class="card rounded shadow p-4 border-0 sticky-bar">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="h5 mb-0 text-warning">متاسفانه پاسخی از پایگاه داده دریافت نشد</span>
                        </div>
                    </div>
                </div>
            }

            <!--end col-->




        </div><!--end row-->
    </div><!--end container-->
</section>